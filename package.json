{
    "name": "monitoring-system",
    "version": "1.0.0",
    "description": "Monitoring System (MS) is a purpose-built system for Filian's ARG that monitors various ARG components, including YouTube, Twitter, and custom websites. It is primarily used by the community to stay updated on the latest changes across these platforms.",
    "keywords": [
        "monitor",
        "system",
        "ARG"
    ],
    "homepage": "https://github.com/wiore64/Monitoring-System#readme",
    "license": "GPL-3.0-only",
    "author": "Wiore",
    "main": "bootstrap.js",
    "type": "module",
    "imports": {
        "#/*.js": {
            "production": "./dist/*.js",
            "development": "./src/*.ts"
        },
        "#monitor/*.js": {
            "production": "./dist/monitor/*.js",
            "development": "./src/monitor/*.ts"
        },
        "#utils/*.js": {
            "production": "./dist/utils/*.js",
            "development": "./src/utils/*.ts"
        }
    },
    "scripts": {
        "clean": "rimraf dist",
        "build": "tsc",
        "prod": "node --conditions=production --env-file=.env dist/bootstrap.js",
        "dev": "tsx watch --conditions=development --env-file=.env src/bootstrap.ts"
    },
    "dependencies": {
        "prettier": "^3.9.6"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
