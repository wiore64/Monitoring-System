{
  "name": "monitoring-system",
  "version": "1.0.0",
  "description": "Monitoring System (MS) is a purpose-built system for Filian's ARG that monitors various ARG components, including YouTube, Twitter, and custom websites. It is primarily used by the community to stay updated on the latest changes across these platforms.",
  "keywords": [
    "monitor",
    "system",
    "ARG"
  ],
  "homepage": "https://github.com/wiore64/Monitoring-System#readme",
  "license": "GPL-3.0-only",
  "author": "Wiore",
  "main": "bootstrap.js",
  "type": "module",
  "imports": {
    "#root/*.js": {
      "production": "./dist/*.js",
      "development": "./src/*.ts"
    },
    "#data/*.json": "./data/*.json",
    "#monitor/*.js": {
      "production": "./dist/monitor/*.js",
      "development": "./src/monitor/*.ts"
    },
    "#shared/*.js": {
      "production": "./dist/shared/*.js",
      "development": "./src/shared/*.ts"
    },
    "#utils/*.js": {
      "production": "./dist/shared/utils/*.js",
      "development": "./src/shared/utils/*.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "clean": "rimraf dist",
    "build": "tsc",
    "prod": "node --conditions=production --env-file=.env dist/bootstrap.js",
    "dev": "tsx watch --conditions=development --env-file=.env src/bootstrap.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "prettier": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.74.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
